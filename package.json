    "typecheck": "tsc --noEmit",
    "db:init": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "2.4.3",
    "jose": "6.1.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.16.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22 <25"
  }
