generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}
enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}
enum OpportunityStage {
  IDENTIFIED
  QUALIFIED
  CONTACTED
  NEEDS_ASSESSMENT
  QUOTATION
  NEGOTIATION
  WON
  LOST
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}
enum ImportStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum AgentStatus {
  ENABLED
  PAUSED
  DISABLED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  createdAt DateTime @default(now())
  memberships WorkspaceMember[]
  logs AuditLog[]
}
model Workspace {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  businesses Business[]
  accounts Account[]
  journals JournalEntry[]
  counterparties Counterparty[]
  opportunities Opportunity[]
  projects Project[]
  tasks Task[]
  products Product[]
  warehouses Warehouse[]
  movements InventoryMovement[]
  imports ImportBatch[]
  approvals ApprovalRequest[]
  agents Agent[]
  documents Document[]
  logs AuditLog[]
  orders TradeOrder[]
  shipments Shipment[]
}
model WorkspaceMember {
  id String @id @default(cuid())
  userId String
  workspaceId String
  role String @default("OWNER")
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([userId,workspaceId])
}
model Business {
  id String @id @default(cuid())
  workspaceId String
  name String
  kind String @default("BUSINESS")
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
  accounts Account[]
  journals JournalEntry[]
  opportunities Opportunity[]
  projects Project[]
  products Product[]
  warehouses Warehouse[]
  orders TradeOrder[]
  shipments Shipment[]
  @@unique([workspaceId,name])
}
model Currency {
  code String @id
  precision Int @default(2)
  accounts Account[]
  journals JournalEntry[]
}
model ExchangeRate {
  id String @id @default(cuid())
  workspaceId String
  base String
  quote String
  rate Decimal @db.Decimal(28,12)
  asOf DateTime
  source String
  @@index([workspaceId,base,quote,asOf])
}
model Account {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  code String
  name String
  type AccountType
  currencyCode String
  isCash Boolean @default(false)
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
  currency Currency @relation(fields:[currencyCode],references:[code])
  lines JournalLine[]
  @@unique([workspaceId,code])
  @@index([workspaceId,businessId])
}
model JournalEntry {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  description String
  reference String?
  currencyCode String
  occurredAt DateTime
  status EntryStatus @default(DRAFT)
  reversalOfId String? @unique
  postedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
  currency Currency @relation(fields:[currencyCode],references:[code])
  lines JournalLine[]
  @@index([workspaceId,occurredAt])
}
model JournalLine {
  id String @id @default(cuid())
  entryId String
  accountId String
  debit Decimal @default(0) @db.Decimal(24,4)
  credit Decimal @default(0) @db.Decimal(24,4)
  memo String?
  entry JournalEntry @relation(fields:[entryId],references:[id],onDelete:Restrict)
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  @@index([accountId])
}
model Counterparty {
  id String @id @default(cuid())
  workspaceId String
  name String
  type String @default("ORGANIZATION")
  email String?
  phone String?
  tags String[] @default([])
  notes String?
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  opportunities Opportunity[]
  communications Communication[]
  orders TradeOrder[]
  @@index([workspaceId,name])
}
model Communication {
  id String @id @default(cuid())
  workspaceId String
  counterpartyId String
  channel String
  notes String
  occurredAt DateTime @default(now())
  counterparty Counterparty @relation(fields:[counterpartyId],references:[id])
  @@index([workspaceId,counterpartyId])
}
model Opportunity {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  counterpartyId String
  title String
  stage OpportunityStage @default(IDENTIFIED)
  value Decimal? @db.Decimal(24,4)
  currencyCode String? 
  nextAction String
  followUpAt DateTime?
  ownerName String
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
  counterparty Counterparty @relation(fields:[counterpartyId],references:[id])
  @@index([workspaceId,stage])
}
model Project {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  title String
  description String?
  startsAt DateTime?
  endsAt DateTime?
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
  tasks Task[]
}
model Task {
  id String @id @default(cuid())
  workspaceId String
  projectId String?
  title String
  status TaskStatus @default(TODO)
  priority Int @default(2)
  dueAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  project Project? @relation(fields:[projectId],references:[id])
  @@index([workspaceId,dueAt])
}
model Product {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  sku String
  name String
  unit String @default("pcs")
  weightKg Decimal? @db.Decimal(18,4)
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
  movements InventoryMovement[]
  @@unique([workspaceId,sku])
}
model Warehouse {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  name String
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
  movements InventoryMovement[]
  @@unique([workspaceId,name])
}
model InventoryMovement {
  id String @id @default(cuid())
  workspaceId String
  productId String
  warehouseId String
  quantity Decimal @db.Decimal(20,4)
  reason String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  product Product @relation(fields:[productId],references:[id])
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  @@index([workspaceId,productId,warehouseId])
}
model TradeOrder {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  counterpartyId String
  direction String
  status String @default("DRAFT")
  currencyCode String
  total Decimal @db.Decimal(24,4)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
  counterparty Counterparty @relation(fields:[counterpartyId],references:[id])
}
model Shipment {
  id String @id @default(cuid())
  workspaceId String
  businessId String?
  reference String
  status String @default("PLANNED")
  freight Decimal @default(0) @db.Decimal(24,4)
  customs Decimal @default(0) @db.Decimal(24,4)
  handling Decimal @default(0) @db.Decimal(24,4)
  currencyCode String
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  business Business? @relation(fields:[businessId],references:[id])
}
model Document {
  id String @id @default(cuid())
  workspaceId String
  name String
  mimeType String
  sha256 String
  storagePath String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  @@unique([workspaceId,sha256])
}
model ImportBatch {
  id String @id @default(cuid())
  workspaceId String
  filename String
  sha256 String
  status ImportStatus @default(PENDING)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  rows ImportRecord[]
  @@unique([workspaceId,sha256])
}
model ImportRecord {
  id String @id @default(cuid())
  batchId String
  rowNumber Int
  payload Json
  status ImportStatus @default(PENDING)
  batch ImportBatch @relation(fields:[batchId],references:[id])
  @@unique([batchId,rowNumber])
}
model Agent {
  id String @id @default(cuid())
  workspaceId String
  name String
  description String?
  status AgentStatus @default(DISABLED)
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  runs AgentRun[]
}
model AgentRun {
  id String @id @default(cuid())
  agentId String
  status String
  summary String?
  createdAt DateTime @default(now())
  agent Agent @relation(fields:[agentId],references:[id])
}
model ApprovalRequest {
  id String @id @default(cuid())
  workspaceId String
  action String
  payload Json
  status ApprovalStatus @default(PENDING)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId],references:[id])
}
model AuditLog {
  id String @id @default(cuid())
  userId String
  workspaceId String
  action String
  entity String
  entityId String
  data Json?
  at DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  workspace Workspace @relation(fields:[workspaceId],references:[id])
  @@index([workspaceId,at])
}
